{
  "schemaVersion": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 8443,
    "databasePath": "/var/lib/agentdeck/push-relay.db",
    "lockPath": "/run/agentdeck/push-relay.pid"
  },
  "apns": {
    "enabled": false,
    "environment": "sandbox",
    "teamId": "YOUR_TEAM_ID",
    "keyId": "YOUR_KEY_ID",
    "bundleId": "com.agentdeck.app",
    "privateKeyPath": "/path/outside/repo/AuthKey.p8"
  },
  "security": {
    "mode": "production",
    "companionSecrets": {
      "cmp_srv_example": "REPLACE_WITH_A_RANDOM_SECRET_OF_32+_CHARS"
    }
  }
}
